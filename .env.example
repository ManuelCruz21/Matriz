# Copy to a private .env at the repository root; never publish the populated .env.
# Required: set a unique strong local database password in your private .env before startup.
DB_PASSWORD=
# Optional local demo only; leave disabled unless needed for evaluation.
# When enabled, supply both demo passwords privately (at least 12 characters each).
DEMO_SEED_ENABLED=false
DEMO_MANAGER_PASSWORD=
DEMO_MEMBER_PASSWORD=
# Em HTTPS, ativar true e configurar proxy/TLS adequadamente
SESSION_COOKIE_SECURE=false

# Email do administrador do Security Center
MATRIZ_SECURITY_ADMIN_EMAIL=admin@example.org
